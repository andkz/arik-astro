---
import fs from 'node:fs';
import path from 'node:path';

const symbolsPath = path.join(process.cwd(), 'src', 'components', 'arik_symbols.html');
let symbolsContent = '';
try {
  symbolsContent = fs.readFileSync(symbolsPath, 'utf-8');
} catch (e) {
  console.warn('Could not read arik_symbols.html:', e.message);
}
---

<svg style="display: none;" xmlns="http://www.w3.org/2000/svg">
  <defs set:html={symbolsContent} />
</svg>
